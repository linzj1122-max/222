{
  "manifest_version": 3,
  "name": "Ozon 排名采集器",
  "version": "1.4.2",
  "description": "读取 Ozon 搜索页上的 MPStats 排名和30天销量表，并发送到运营控制中心。",
  "permissions": ["activeTab", "storage", "tabs", "clipboardRead", "scripting"],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://*.pages.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Ozon 排名采集器",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ozon.ru/*", "https://ozon.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.pages.dev/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
